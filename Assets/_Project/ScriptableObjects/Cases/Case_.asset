  preDocumentDialogue:
  - speaker: 0
    text: "Recebi um e-mail dizendo que minha bolsa est\xE1 sob revis\xE3o, pode
      verificar o motivo por favor?"
  - speaker: 1
    text: Claro, irei verificar nosso sistema...
  - speaker: 1
    text: "O sistema aponta diverg\xEAncia de renda."
  - speaker: 0
    text: "Isso \xE9 imposs\xEDvel."
  - speaker: 1
    text: "Houve alguma altera\xE7\xE3o recente?"
  - speaker: 0
    text: "Meu pai perdeu o emprego, a bolsa s\xF3 deveria entrar em revis\xE3o se
      a renda aumentasse"
  - speaker: 1
    text: Entendo.Existe um recurso administrativo.
  - speaker: 0
    text: E quanto tempo demora?
  - speaker: 1
    text: "At\xE9 trinta dias."
  - speaker: 0
    text: "Trinta dias \xE9 tempo suficiente para eu perder o semestre inteiro."
  postDecisionDialogue:
  - speaker: 0
    text: "Obrigado pela compreens\xE3o"
